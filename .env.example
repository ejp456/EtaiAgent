# EtaiAgent Environment Configuration
# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed to source control.

# LLM Inference (Ollama)
OLLAMA_BASE_URL=http://192.168.86.39:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=32768

# Telegram Bot Bridge
# 1. Message @BotFather on Telegram and send /newbot (or /token) to get your Bot Token
# 2. Paste your token here:
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 3. Message @userinfobot on Telegram to get your numeric user/chat ID, or leave blank to auto-bind on first message:
TELEGRAM_ALLOWED_CHAT_IDS=

# Home Assistant (optional local or network instance)
HA_URL=http://127.0.0.1:8123
HA_TOKEN=

# Philips Hue Bridge IP (optional)
HUE_BRIDGE_IP=192.168.86.46

# Mobile Web / Siri API Port
MOBILE_HOST=0.0.0.0
MOBILE_PORT=8650
